@page "/catalog"
@inject GamesClient Client
@inject NavigationManager NavigationManager
@attribute [StreamRendering]

<PageTitle>Game Catalog</PageTitle>

@if (errorList.Count > 0)
{
    <div class="modal-body">
        @foreach (var error in errorList)
        {
            <div class="alert alert-danger">@error</div>
        }
    </div>
}

<div class="row mt-2">
    <div class="col">
        <a class="btn btn-primary" role="button" href="/catalog/editgame">New Game</a>
    </div>
</div>

<form action="/catalog" method="get" role="search" class="mt-3">
    <label for="game-search" class="form-label">Search games by name</label>
    <div class="d-flex gap-2">
        <input id="game-search" type="search" name="name" value="@Search"
               class="form-control" placeholder="Enter a game name" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Search))
        {
            <a class="btn btn-outline-secondary" href="/catalog">Clear</a>
        }
    </div>
</form>

@if (games is null)
{
    <p><em>Loading...</em></p>
}
else if (games.Length == 0)
{
    <p class="mt-3" role="status">No games found.</p>
}
else
{
    <table class="table table-striped table-bordered table-hover mt-3">
        <thead class="table-dark">
            <th>Image</th>
            <th>Name</th>
            <th>Genre</th>
            <th class="text-end">Price</th>
            <th>Release Date</th>
            <th></th>
        </thead>
        <tbody>
            @foreach (var game in games)
            {
                <tr>
                    <td class="align-middle">
                        @if (!string.IsNullOrWhiteSpace(game.ImageUri))
                        {
                            <img src="@game.ImageUri" alt="@game.Name cover"
                                 class="game-image rounded" width="80" height="80" loading="lazy" />
                        }
                        else
                        {
                            <span class="game-image d-inline-flex align-items-center justify-content-center rounded border bg-body-secondary text-body-secondary small"
                                  role="img" aria-label="@($"No image for {game.Name}")">No image</span>
                        }
                    </td>
                    <td>@game.Name</td>
                    <td>@game.Genre</td>
                    <td class="text-end">$@game.Price</td>
                    <td>@game.ReleaseDate</td>
                    <td>
                        <div class="d-flex">
                            <a class="btn btn-primary me-2" role="button" href="@GameUrl(game.Id)">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="@GetDeleteModalId(game)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <DeleteGame Game="@game" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 0)
    {
        <nav aria-label="Catalog pages" class="d-flex align-items-center gap-3">
            @if (CurrentPage > 1)
            {
                <a class="btn btn-outline-primary" href="@PageUrl(CurrentPage - 1)">Previous</a>
            }
            <span>Page @CurrentPage of @totalPages</span>
            @if (CurrentPage < totalPages)
            {
                <a class="btn btn-outline-primary" href="@PageUrl(CurrentPage + 1)">Next</a>
            }
        </nav>
    }
}

<form @formname="delete-game-form" @onsubmit="@ConfirmDeleteAsync"></form>

@code {
    private GameSummary[]? games;
    private int totalPages;

    [SupplyParameterFromQuery]
    public int PageNumber { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "name")]
    public string? Search { get; set; }

    private int CurrentPage => Math.Max(1, PageNumber);

    [SupplyParameterFromForm]
    private Guid? GameIdToDelete { get; set; }

    private List<string> errorList = [];

    protected override async Task OnParametersSetAsync()
    {
        var page = await Client.GetGamesAsync(CurrentPage, Search);
        games = page.Data;
        totalPages = page.TotalPages;
    }

    private string PageUrl(int pageNumber)
        => $"/catalog?pageNumber={pageNumber}&name={Uri.EscapeDataString(Search ?? string.Empty)}";

    private static string GameUrl(Guid id) => $"/catalog/editgame/{id}";

    private string GetDeleteModalId(GameSummary game)
    {
        return $"#{DeleteGame.GetModalId(game)}";
    }
    private async Task ConfirmDeleteAsync()
    {
        errorList.Clear();
        var result = await Client.DeleteGameAsync(GameIdToDelete!.Value);

        if (result.Succeeded)
        {
            NavigationManager.Refresh();
        }
        else
        {
            errorList = result.Errors;
        }
    }
}